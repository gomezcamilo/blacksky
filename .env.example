# =============================================
# BLACK SKY - Variables de Entorno
# =============================================

# CONFIGURACIÓN DE LA APLICACIÓN
APP_NAME=BLACK_SKY
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true

# =============================================
# API - CONFIGURAR DESPUÉS DEL DESPLIEGUE
# =============================================
# Desarrollo local
API_BASE_URL=http://localhost:3001/api

# Producción (cambiar después del despliegue)
# API_BASE_URL=https://tu-dominio.com/api

API_VERSION=v1
API_TIMEOUT=30000

# =============================================
# BASE DE DATOS
# =============================================
# Desarrollo local
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=black_sky_db
DB_USERNAME=root
DB_PASSWORD=

# Producción (ejemplo InfinityFree/Byethost)
# DB_HOST=sql123.byethost.com
# DB_DATABASE=b123_12345678_blacksky
# DB_USERNAME=b123_12345678
# DB_PASSWORD=tu_password_seguro

# =============================================
# AUTENTICACIÓN Y SEGURIDAD
# =============================================
JWT_SECRET=cambiar_este_secret_en_produccion_muy_largo_y_seguro
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
RECOVERY_CODE_SECRET=otro_secret_para_recovery_codes_cambiar

# =============================================
# ENCRIPTACIÓN
# =============================================
AES_ENCRYPTION_KEY=clave_aes_32_caracteres_cambiar!
ENCRYPTION_SALT=salt_personalizado_cambiar_prod

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_POST_CREATE=10
RATE_LIMIT_MESSAGE_SEND=30
RATE_LIMIT_API_GENERAL=100

# =============================================
# ARCHIVOS
# =============================================
MAX_FILE_SIZE=10
MAX_IMAGE_SIZE=5
MAX_AVATAR_SIZE=2
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

# =============================================
# CORS
# =============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# =============================================
# SERVICIOS EXTERNOS (Opcionales)
# =============================================

# Cloudinary para imágenes
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

# Stripe para pagos VIP
# STRIPE_PUBLIC_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx

# =============================================
# LOGS
# =============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# =============================================
# WEBSOCKETS (para chat en tiempo real)
# =============================================
WS_PORT=3002
WS_PATH=/socket.io
